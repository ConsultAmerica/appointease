// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum SpecialRequestStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Business {
  id               String              @id @default(cuid())
  name             String
  timezone         String              @default("UTC")
  emailFrom        String?
  users            User[]
  services         Service[]
  availability     AvailabilityRule[]
  appointments     Appointment[]
  notificationLogs NotificationLog[]
  timeBlocks       TimeBlock[]
  staffAvailabilityRules StaffAvailabilityRule[]
  agentConversationLogs AgentConversationLog[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model User {
  id           String    @id @default(cuid())
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  role         UserRole  @default(CUSTOMER)
  fullName     String
  email        String    @unique
  passwordHash String
  emailVerifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  verificationTokens VerificationToken[]
  resetTokens PasswordResetToken[]
  authAuditLogs AuthAuditLog[]
  assignedAppointments Appointment[] @relation("AppointmentStaff")
  staffAvailabilityRules StaffAvailabilityRule[]
  staffTimeBlocks TimeBlock[] @relation("StaffTimeBlocks")
  agentConversationLogs AgentConversationLog[]
  staffServices StaffService[]
}

model StaffService {
  id          String   @id @default(cuid())
  staffUserId String
  staffUser   User     @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([staffUserId, serviceId])
  @@index([serviceId])
}

enum AuthEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  EMAIL_VERIFIED
  RESEND_VERIFICATION
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
}

model AuthAuditLog {
  id         String        @id @default(cuid())
  event      AuthEventType
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([event, createdAt])
}

model VerificationToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
}

model Service {
  id                String        @id @default(cuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  durationMinutes   Int
  /** Minutes after this service ends before another booking may start (turnover / cleanup). */
  bufferMinutesAfter Int          @default(0)
  priceCents        Int           @default(0)
  isActive          Boolean       @default(true)
  appointments      Appointment[]
  staffServices     StaffService[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model AvailabilityRule {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Appointment {
  id                     String            @id @default(cuid())
  businessId             String
  business               Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId              String
  service                Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignedStaffUserId    String?
  assignedStaff          User?             @relation("AppointmentStaff", fields: [assignedStaffUserId], references: [id], onDelete: SetNull)
  customerName           String
  customerEmail          String
  startAt                DateTime
  endAt                  DateTime
  status                 AppointmentStatus @default(PENDING)
  /** True when the booking was created from the AI assistant (live tools or demo portfolio flow). */
  createdViaAiChat       Boolean           @default(false)
  specialRequestNote     String?
  specialRequestStatus    SpecialRequestStatus @default(NONE)
  reminderSentAt         DateTime?
  confirmationSentAt     DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([businessId, startAt])
  @@index([businessId, status])
  @@index([assignedStaffUserId])
}

model TimeBlock {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffUserId String?
  staffUser   User?    @relation("StaffTimeBlocks", fields: [staffUserId], references: [id], onDelete: Cascade)
  startAt     DateTime
  endAt       DateTime
  reason      String?

  @@index([businessId, startAt])
}

model StaffAvailabilityRule {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffUserId String
  staffUser   User     @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, staffUserId])
}

model AgentConversationLog {
  id            String    @id @default(cuid())
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerEmail String?
  messages      Json
  reply         String    @db.Text
  createdAt     DateTime  @default(now())

  @@index([businessId, createdAt])
}

model NotificationLog {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId  String?
  type           String
  targetEmail    String
  success        Boolean
  providerStatus String?
  createdAt      DateTime @default(now())
}
